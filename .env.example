# Copie para .env e ajuste. O processo NAO sobe com config faltando (D-06).

# development | production
APP_ENV=development

# O Railway injeta PORT automaticamente. Local usa este valor.
PORT=8080

# O Railway injeta DATABASE_URL automaticamente.
# Local: corresponde ao docker-compose.yml.
DATABASE_URL=postgres://meuauto:meuauto@localhost:5433/meuauto?sslmode=disable

# Minimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me-at-least-32-characters-long

# debug | info | warn | error
LOG_LEVEL=debug

# Lista separada por virgula. "*" libera qualquer origem (so em development).
CORS_ORIGINS=*

# true SOMENTE quando houver um proxy na frente (Railway, Caddy, nginx).
# Se true sem proxy, qualquer um falsifica o X-Forwarded-For e escapa do rate limit.
# Se false COM proxy, todos os usuarios compartilham um unico IP no rate limit.
TRUST_PROXY=false

# E-mail transacional. Obrigatorios em production (reset de senha envia e-mail de verdade).
# Vazios em development: o link do reset e escrito no log em vez de enviado.
# Valores com espaco ou caractere especial PRECISAM de aspas: `make run` carrega este
# arquivo com `. ./.env`, e um < sem aspas vira redirecionamento de shell.
RESEND_API_KEY=
MAIL_FROM="Meu Auto <nao-responda@meuauto.com.br>"

# Deep link do app para a tela de redefinir senha. O token e anexado como ?token=
PASSWORD_RESET_URL=meuauto://redefinir-senha

# Catalogo de veiculos (marca / modelo / ano) baseado na tabela FIPE.
#
# URL: opcional. Vazio usa a API publica da Parallelum (v2). Preencha so para apontar
# para um espelho proprio ou para um servidor de teste.
FIPE_API_URL=

# Token: OPCIONAL, e um SEGREDO. Sem ele a cota e de 500 requisicoes por dia; com um token
# gratuito, 1000. Viaja para o fornecedor como header X-Subscription-Token — nunca vai
# para a URL, nunca para o log, nunca para o app.
#
# NAO coloque o valor real aqui: este arquivo e versionado. O real fica no .env.
FIPE_API_TOKEN=
